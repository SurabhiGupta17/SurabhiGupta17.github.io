---
import Base from "../layouts/Base.astro";
---

<Base title="Surabhi Gupta">
  <div class="col">
    <div class="home-header">
      <img src="/images/surabhi.jpg" alt="Surabhi Gupta" class="home-photo" />
      <div class="home-header-text">
        <h1 class="home-hi">Hi! I'm Surabhi</h1>
        <p class="lede" style="margin-top: 22px;">
          I build robot arms and mobile robots, and work on the ROS2 / middleware layer
          underneath them. I'm a robotics engineer at <a class="link-underline" href="https://earthsense.co/" target="_blank" rel="noopener noreferrer">EarthSense</a>. Previously, I interned at <a class="link-underline" href="https://www.peppermintrobotics.com/" target="_blank" rel="noopener noreferrer">Peppermint Robotics</a>, where I worked on firmware, and at <a class="link-underline" href="https://getvectorbots.com/" target="_blank" rel="noopener noreferrer">Vector Robotics</a>, where I built out the teleop stack for a semi-humanoid robot.
        </p>
        <p class="lede" style="margin-top: 16px;">
          I'm 22. I <a class="link-underline" href="/writing/">write</a> about stuff I work on and find interesting. My <a class="link-underline" href="/build-log/">build log</a> also documents the things I work on.
        </p>
      </div>
    </div>

    <hr style="margin: 18px 0; border: none; border-top: 1px solid var(--border);" />

    <div class="home-now">
      <div class="home-now-item" style="display: block;">
        <div class="home-now-label">Currently</div>
        <div class="home-tile-row">
          <img class="home-now-thumb" src="/images/earthsense.jpeg" alt="EarthSense agricultural robot" />
          <div class="home-now-value">
            Working on agri-robots at <a class="link-underline" href="https://earthsense.co/" target="_blank" rel="noopener noreferrer">EarthSense</a>
          </div>
        </div>
      </div>
      <hr class="home-now-divider" />
      <div class="home-now-item" style="display: block;">
        <div class="home-now-label">Recent Work</div>
        <a class="home-preview-tile" href="/writing/cyclonedds-fix/">
          <div class="home-preview-tile-title">
            Tuning CycloneDDS to fix LiDAR data delivery problems <span class="home-post-arrow">→</span>
          </div>
          <div class="home-preview-tile-desc">
            Root-causing a cross-machine LiDAR/IMU data delivery failure to IP fragmentation, and
            fixing it via CycloneDDS config tuning.
          </div>
        </a>
      </div>
    </div>

    <hr style="margin: 18px 0; border: none; border-top: 1px solid var(--border);" />

    <p style="font-size: 16px; text-align: center;">
      <a href="https://github.com/SurabhiGupta17" target="_blank" rel="noopener noreferrer">GitHub</a>
      <span style="margin: 0 10px; color: var(--muted);">&middot;</span>
      <a href="https://x.com/this_is_surabhi" target="_blank" rel="noopener noreferrer">X</a>
      <span style="margin: 0 10px; color: var(--muted);">&middot;</span>
      <a href="https://www.linkedin.com/in/surabhisgupta/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <span style="margin: 0 10px; color: var(--muted);">&middot;</span>
      <a href="mailto:surabhi.gupta1617@gmail.com">Email</a>
    </p>
  </div>
</Base>
